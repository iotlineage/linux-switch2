 	for (i = 0; i < key_count; i++) {
@@ -9601,6 +9610,43 @@ static int get_adv_size_info(struct sock *sk, struct hci_dev *hdev,
 				 MGMT_STATUS_SUCCESS, &rp, sizeof(rp));
 }
 
+extern int hci_switch2_add_ltk(struct hci_dev *hdev, bdaddr_t *peer, u8 key[16]);
+struct switch2_key_request {
+    u8 magic[16], operation, address[6], key[16];
+} __packed;
+static u8 switch2_key_magic[16] = {
+    0x85,0x19,0xa2,0x14,0x69,0x2b,0x43,0xc5,
+    0xb8,0x72,0x7e,0x06,0x58,0xe2,0x10,0x01
+};
+static int switch2_key(struct sock *sk, struct hci_dev *hdev, void *data, u16 len)
+{
+    struct switch2_key_request *cp = data;
+    bdaddr_t peer;
+    u8 status = MGMT_STATUS_SUCCESS;
+    int err = 0;
+    if (memcmp(cp->magic, switch2_key_magic, sizeof(cp->magic)) || cp->operation > 1)
+        return mgmt_cmd_status(sk, hdev->id, MGMT_OP_SWITCH2_KEY, MGMT_STATUS_INVALID_PARAMS);
+    if (!lmp_le_capable(hdev))
+        return mgmt_cmd_status(sk, hdev->id, MGMT_OP_SWITCH2_KEY, MGMT_STATUS_NOT_SUPPORTED);
+    if (cp->operation) {
+        memcpy(&peer, cp->address, sizeof(peer));
+        if (!bacmp(&peer, BDADDR_ANY) || !bacmp(&peer, BDADDR_NONE))
+            return mgmt_cmd_status(sk, hdev->id, MGMT_OP_SWITCH2_KEY, MGMT_STATUS_INVALID_PARAMS);
+        hci_dev_lock(hdev);
+        if (hci_dev_test_flag(hdev, HCI_UNREGISTER))
+            err = -ENODEV;
+        else if (hci_is_blocked_key(hdev, HCI_BLOCKED_KEY_TYPE_LTK, cp->key))
+            err = -EPERM;
+        else
+            err = hci_switch2_add_ltk(hdev, &peer, cp->key);
+        hci_dev_unlock(hdev);
+        if (err == -EEXIST) status = MGMT_STATUS_ALREADY_PAIRED;
+        else if (err) status = mgmt_errno_status(err);
+    }
+    return mgmt_cmd_complete(sk, hdev->id, MGMT_OP_SWITCH2_KEY, status,
+                             switch2_key_magic, sizeof(switch2_key_magic));
+}

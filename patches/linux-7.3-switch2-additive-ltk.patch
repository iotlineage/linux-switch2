+struct smp_ltk *hci_add_ltk(struct hci_dev *hdev, bdaddr_t *bdaddr,
+                          u8 addr_type, u8 type, u8 authenticated,
+                          u8 tk[16], u8 enc_size, __le16 ediv, __le64 rand)
+{
+    guard(spinlock_bh)(&switch2_ltk_lock);
+    return __hci_add_ltk(hdev, bdaddr, addr_type, type, authenticated,
+                        tk, enc_size, ediv, rand);
+}
+
+/* No replacement, removal, list reload, HCI traffic or connection reset. */
+int hci_switch2_add_ltk(struct hci_dev *hdev, bdaddr_t *peer, u8 key[16])
+{
+    struct smp_ltk *ltk;
+    guard(spinlock_bh)(&switch2_ltk_lock);
+    list_for_each_entry(ltk, &hdev->long_term_keys, list) {
+        if (ltk->bdaddr_type != ADDR_LE_DEV_PUBLIC || bacmp(peer, &ltk->bdaddr))
+            continue;
+        if (ltk->type == SMP_LTK && !ltk->authenticated &&
+            ltk->enc_size == 16 && !ltk->ediv && !ltk->rand &&
+            !memcmp(ltk->val, key, 16))
+            return 0;
+        return -EEXIST;
+    }
+    if (hci_conn_hash_lookup_le(hdev, peer, ADDR_LE_DEV_PUBLIC))
+        return -EBUSY;
+    return __hci_add_ltk(hdev, peer, ADDR_LE_DEV_PUBLIC, SMP_LTK,
+                        0, key, 16, 0, 0) ? 0 : -ENOMEM;
+}
+
+void hci_switch2_ltk_identity(struct smp_ltk *key, bdaddr_t *peer, u8 type)
+{
+    guard(spinlock_bh)(&switch2_ltk_lock);
+    key->bdaddr_type = type;
+    bacpy(&key->bdaddr, peer);
+}
+
+void hci_switch2_free_ltk(struct hci_dev *hdev, struct smp_ltk *key)
+{
+    struct smp_ltk *candidate;
+    guard(spinlock_bh)(&switch2_ltk_lock);
+    list_for_each_entry(candidate, &hdev->long_term_keys, list) {
+        if (candidate != key) continue;
+        list_del_rcu(&candidate->list);
+        kfree_rcu(candidate, rcu);
+        break;
+    }
+}
